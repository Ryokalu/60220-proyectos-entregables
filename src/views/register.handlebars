<header class="bg-primary text-white text-center py-2">
    <h1>Registrate en nuestro sitio :D</h1>
</header>

<div class="d-flex justify-content-center align-items-center">
    <div class="p-3 bg-light border">
        <div class="row justify-content-center align-items-center">
            <div class="col ">
                <p> Nombre</p>
                <input type="text" id="txtName">
                <p> Apellido</p>
                <input type="text" id="txtLastName">
                <p> Email</p>
                <input type="text" id="txtEmail">
                <p> Edad</p>
                <input type="text" id="txtAge">
                <p> Contraseña</p>
                <input type="password" id="txtPassword">
                <p> Validar Contraseña</p>
                <input type="password" id="txtPasswordValidate">
                <button id="btnRegister"> Registrar </button>
            </div>
        </div>
        <div class="justify-content-center align-items-center">
            <p>Tienes una Cuenta? <a href="/login">Inicia Sesion Aqui</a></p>
        </div>
    </div>
</div>




