{{#if valid}}
<header class="bg-primary text-white text-center py-2">
    <h1>Productos</h1>
    <nav>
        <a href="/user/current" class="text-white mx-2"> Ir a Usuario</a>
        {{!-- <a href="/products" class="text-white mx-2">Ir a Productos</a> --}}
        <a href="" id="enlace" class="text-white mx-2">Ir a Carrito</a>
        <button id="close" class="btn btn-link text-white mx-2">Cerrar sesion</button>
    </nav>
</header>

<div class="d-flex justify-content-center align-items-center">
    <div class="p-3 bg-light border">
        <div class="row justify-content-center align-items-center">
            <div>
                <h1 id="hUser" class="text-center">BIENVENIDO "" sr/a "" Edad </h1>
            </div>
            {{#each payload}}
            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body text-center">
                        <p>Titulo : {{this.title}} </p>
                        <p>descripción : {{this.description}} </p>
                        <p>Codigo : {{this.code}} </p>
                        <p>Estado : {{this.status}} </p>
                        <p>Precio : {{this.price}} </p>
                        <p>Stock : {{this.stock}} </p>
                        <p>categoria : {{this.category}} </p>
                    </div>
                    <button class="common btn btn-primary" name={{this.id}}>agregar al carrito</button>
                </div>
            </div>

            {{/each}}
        </div>
    </div>
</div>
<div class="bg-primary">
    <h2 class="text-center bg-primary"> Mas productos</h2>
    <div class="pagination-wrapper">
        {{#if hasPrevPage}}
        <nav>
            <ul class="pagination ">
                <li class="page-item">
                    <a class="page-link bg-success text-dark" href={{this.prevLink}} aria-label="Previous">
                        <span aria-hidden="true">&laquo; Ir a Pagina anterior</span>
                    </a>
                </li>
            </ul>
        </nav>

        {{/if}}
        <nav class="page-numbers">
            <ul class="pagination">
                <li class="page-item">Te encuentras en la pagina: {{this.page}}</li>
            </ul>
        </nav>

        {{#if hasNextPage}}
        <nav>
            <ul class="pagination">
                <li class="page-item">
                    <a class="page-link bg-success text-dark" href={{this.nextLink}} aria-label="Next">
                        <span aria-hidden="true">Ir a Pagina Siguiente &raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>
        {{/if}}
    </div>
</div>
{{else}}
<h1>NO HAY PRODUCTOS CON LA BUSQUEDA APLICADA</h1>
{{/if}}

<style>
    .pagination-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .page-numbers {
        display: flex;
        justify-content: center;
        flex-grow: 1;
    }
</style>


<script src="/js/cart.js"></script>