<header class="bg-primary text-white text-center py-2">
    <h1>Carrito</h1>
    <nav>
        <a href="/user/current" class="text-white mx-2"> Ir a Usuario</a>
        <a href="/products" class="text-white mx-2">Ir a Productos</a>
        <button id="close" class="btn btn-link text-white mx-2">Cerrar sesion</button>
    </nav>
</header>

<div class="d-flex justify-content-center align-items-center">
    <div class="p-3 bg-light border">
        <div class="row justify-content-center align-items-center">

            {{#if success}}
            {{#each docs}}
            {{#each this.products}}
            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-body text-center">
                        <p>Titulo : {{this.products.title}} </p>
                        <p>descripción : {{this.products.description}} </p>
                        {{!-- <p>Code : {{this.products.code}} </p> --}}
                        {{!-- <p>Status : {{this.products.status}} </p> --}}
                        <p>Precio : {{this.products.price}} </p>
                        <p>Stock : {{this.products.stock}} </p>
                        <p>categoria : {{this.products.category}} </p>
                        <p>Cantidad : {{this.quantity}} </p>
                    </div>
                </div>
            </div>
            {{/each}}
            {{/each}}

            {{else}}
            <h1>NO hay carrito</h1>
            {{/if}}


        </div>
    </div>
</div>
<button id="btnComprar" class="btn btn-success fixed-bottom-btn">Comprar</button>




<style>
    .fixed-bottom-btn {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 1000;
    }
</style>

<script src="/js/buyProducts.js"></script>